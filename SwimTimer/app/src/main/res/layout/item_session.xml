<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <View
        android:id="@+id/cardBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/record_border"
        android:visibility="gone"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_translucent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="#33FFFFFF"/>

            <TextView
                android:id="@+id/tvThumbPlaceholder"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:text="&#127944;"
                android:textSize="28sp"
                android:gravity="center"
                android:background="#22FFFFFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRecordBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127942; RECORD SPECIALITA'"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFD600"
                    android:letterSpacing="0.05"
                    android:visibility="gone"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvImportedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#128229; Importata"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:background="#FFD600"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvSessionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvSessionDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#88E0F0"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvSessionTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#FFD600"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:tint="#FF5252"
                android:contentDescription="Elimina"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textSize="28sp"
                android:textColor="#88E0F0"
                android:layout_marginStart="4dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
