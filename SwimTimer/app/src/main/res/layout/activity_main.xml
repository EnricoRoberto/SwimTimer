<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pool_deep">

    <!-- Animated wave background -->
    <com.swimtimer.app.WaveView
        android:id="@+id/waveView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

       <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:minHeight="64dp"
            android:background="@color/pool_deep"
            android:elevation="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:titleTextColor="@android:color/white"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Title"
            app:contentInsetStartWithNavigation="0dp"/>
        
        <!-- Pulsante setup opzionale -->
        <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="⚙  Imposta atleta e specialità"
        android:textSize="13sp"
        android:textColor="#212121"
        android:textStyle="bold"
        app:backgroundTint="#FFD600"
        app:cornerRadius="0dp"
        style="@style/Widget.MaterialComponents.Button"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <!-- Swimmer animation strip + contatore vasche -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="4dp">

            <com.swimtimer.app.SwimmerAnimView
                android:id="@+id/swimmerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tvLapCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="10dp"
                android:text="0/4"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Timer card with translucent pool-glass effect -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_translucent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <!-- Lane lines decoration -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/lane_rope"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.4"/>

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:00.00"
                    android:textSize="60sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeMaxTextSize="60sp"
                    android:autoSizeStepGranularity="2sp"
                    android:shadowColor="#40000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:letterSpacing="0.05"/>                 

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/lane_rope"
                    android:layout_marginTop="12dp"
                    android:alpha="0.4"/>

                <TextView
                    android:id="@+id/tvCurrentLap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Vasca corrente: 00:00.00"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="#CCE0F0"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLap"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/lap"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="15sp"
                app:icon="@drawable/ic_lap"
                app:iconTint="@android:color/white"
                app:iconSize="20dp"
                app:iconGravity="top"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/btn_lap"
                android:enabled="false"/>

<com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoStart"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="0.8"
                android:layout_marginEnd="4dp"
                android:text="&#127908;"
                android:textSize="22sp"
                android:textColor="@android:color/white"
                app:iconSize="0dp"
                app:cornerRadius="32dp"
                app:backgroundTint="#546E7A"
                style="@style/Widget.MaterialComponents.Button"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1.5"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/start"
                android:textSize="15sp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_play"
                app:iconTint="@android:color/white"
                app:iconSize="22dp"
                app:iconGravity="textStart"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/btn_start"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/reset"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="15sp"
                app:icon="@drawable/ic_reset"
                app:iconTint="@android:color/white"
                app:iconSize="20dp"
                app:iconGravity="top"
                app:cornerRadius="32dp"
                app:backgroundTint="@color/btn_reset"
                android:enabled="false"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>

        <!-- Laps header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <View android:layout_width="24dp" android:layout_height="2dp"
                android:background="@color/lane_rope" android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/laps_header"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:textColor="#BBE0F0"/>
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@color/lane_rope" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLaps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- Logo San Vito Nuoto in basso -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="220dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:src="@drawable/sanvito_logo"
        android:alpha="0.30"
        android:scaleType="fitCenter"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
